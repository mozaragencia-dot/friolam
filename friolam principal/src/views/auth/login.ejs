<!doctype html><html><head><meta charset='utf-8'><title>Login FRIOLAM</title><link rel='stylesheet' href='/static/css/app.css'></head>
<body class='center'>
<form method='post' class='card'>
<h1>FRIOLAM</h1>
<p>Ingreso al sistema técnico</p>
<% if (typeof error !== 'undefined') { %><p class='error'><%= error %></p><% } %>
<input name='email' type='email' placeholder='correo' required>
<input name='password' type='password' placeholder='contraseña' required>
<button>Ingresar</button>
</form>
</body></html>
